#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# The three checks a commit has to pass. CI runs the same three on every pull
# request, so a green run here means what a green run there means.

echo "== rspec =="
bundle exec rspec

echo
echo "== rubocop =="
bundle exec rubocop

echo
echo "== doc drift =="
bundle exec bin/doc-drift-check
